# The paper travels with the code.  paper/ is tracked, including the generated
# tables and figures and the compiled PDF, so that the repository is readable
# without running the pipeline first.  What is not tracked is the Overleaf
# bundle and the zip, because `make overleaf` rebuilds both from paper/.
overleaf/
*.zip

# LaTeX build products.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Data.  Everything under data/ is either downloaded by
# scripts/01_download_data.py or generated by the pipeline, so none of it
# belongs in version control.  data/results/*.json is the one arguable case:
# it is small and it is what the paper quotes, but it is also reproducible by
# `make all`, and keeping it out means the repository cannot drift from the
# scripts.
data/

# Environments and build artefacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# macOS
.DS_Store

# The research plan is working notes, not a deliverable.
research.tex
