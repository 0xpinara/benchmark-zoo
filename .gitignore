# The paper is not published from this repository.  The LaTeX sources, the
# generated tables and figures, and the Overleaf bundle stay local; what is
# public is the code that produces them.
paper/
overleaf/
overleaf */
*.zip

# Data.  Everything under data/ is either downloaded by
# scripts/01_download_data.py or generated by the pipeline, so none of it
# belongs in version control.  data/results/*.json is the one arguable case:
# it is small and it is what the paper quotes, but it is also reproducible by
# `make all`, and keeping it out means the repository cannot drift from the
# scripts.
data/

# Environments and build artefacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# macOS
.DS_Store

# The research plan is a paper source too, and follows the same rule.
research.tex
